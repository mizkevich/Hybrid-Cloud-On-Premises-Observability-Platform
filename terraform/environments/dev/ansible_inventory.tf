resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../../../ansible/inventory/hosts.yml"
  file_permission = "0644"
  content         = <<-EOT
    # Auto-generated by Terraform — Do not edit manually
    all:
      children:
        aws_nodes:
          hosts:
            ${var.project_name}-${var.environment}-ec2:
              ansible_host: ${aws_instance.monitoring_target.public_ip}
              private_ip: ${aws_instance.monitoring_target.private_ip}
              ansible_user: ubuntu
              ansible_ssh_private_key_file: ~/.ssh/hybrid_infra_ed25519
              ansible_python_interpreter: /usr/bin/python3
              wireguard_ip: 10.10.0.50
  EOT
}
